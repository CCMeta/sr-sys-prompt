[Unit]
Description=Sourcegraph FastMCP Service
After=network.target

[Service]
User=root
Group=root
WorkingDirectory=/media/sw-ai-server/data/sr-sys-prompt
ExecStart=/home/sw-ai-server/.local/bin/uv run fastapi dev --reload --port 8020 --host 0.0.0.0
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
